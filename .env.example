# ─────────────────────────────────────────────────────────────
# JARVIS 环境变量示例
#
# 使用方式：
#   cp .env.example .env      （Linux/macOS）
#   copy .env.example .env    （Windows）
# 然后按下面注释填入自己机器上的值。.env 已在 .gitignore 中，不会被提交。
#
# 每个变量都可以通过同名的环境变量覆盖（不依赖 .env 文件也能运行）。
# ─────────────────────────────────────────────────────────────

# ── 应用 ────────────────────────────────────────────────────
# dev 开启详细日志与调试信息；prod 收敛输出
JARVIS_ENV=dev
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_LOG_LEVEL=DEBUG

# ── Home Assistant ──────────────────────────────────────────
# HA 默认跑在 Docker 里，端口见 docker-compose.yml
JARVIS_HA_URL=http://localhost:8123

# 长期访问令牌（Long-Lived Access Token）
# 获取方式：HA 界面 → 左下角用户名 → 安全 → 创建令牌
# 注意：这是密钥，绝不提交到版本库
JARVIS_HA_TOKEN=

# HA 请求超时（秒）
JARVIS_HA_TIMEOUT_SECONDS=5.0

# ── LLM ─────────────────────────────────────────────────────
# stub   = 桩实现，不调用任何模型（无 GPU 或不想跑模型时用这个）
# ollama = 调用本机或远程 Ollama 服务
#
# 无 GPU 的开发机建议保持 stub，只验证确定性逻辑；
# 需要真模型时改为 ollama，并确保 Ollama 已启动。
JARVIS_LLM_PROVIDER=stub

# Ollama 服务地址（仅在 JARVIS_LLM_PROVIDER=ollama 时生效）
JARVIS_OLLAMA_URL=http://localhost:11434

# 模型名称。8GB 显存可用 qwen2.5:7b-instruct；显存更大可换更大模型
JARVIS_MODEL_NAME=qwen2.5:7b-instruct

# LLM 请求超时（秒）。CPU 推理很慢，默认给足
JARVIS_LLM_TIMEOUT_SECONDS=120.0

# ── 存储 ────────────────────────────────────────────────────
# SQLite 路径。相对路径以项目根目录为基准
JARVIS_DATABASE_PATH=data/jarvis.db

# ── 安全 ────────────────────────────────────────────────────
# 高危工具（如开门锁）是否要求二次确认
# MVP 阶段为 false，但确认接口与调用路径始终保留
JARVIS_CONFIRM_HIGH_RISK=false
