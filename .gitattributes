# 统一使用 LF，避免 Windows CRLF 导致容器内脚本失败
* text=auto

*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.sql   text eol=lf

# Windows 脚本保留 CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.ico   binary
*.db    binary
